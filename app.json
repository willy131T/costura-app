{
  "expo": {
    "name": "costura-app",
    "slug": "costura-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "costuraapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.costuraapp.taller",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "CosturaApp necesita acceso a tus fotos para guardar muestras de telas y diseños.",
          "cameraPermission": "CosturaApp necesita acceso a la cámara para tomar fotos de telas y medidas de clientas."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6504a0ab-e3b3-47bf-a9ad-dfa848ec337e"
      }
    }
  }
}
